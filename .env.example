# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional Google sign-in via Supabase Auth. Use the project's publishable/anon key, never its service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional Gemini AI Workspace. Keep this key server-side; never use a VITE_ prefix.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional overrides
PORT=8787
# DATABASE_PATH=./data/trace.sqlite
